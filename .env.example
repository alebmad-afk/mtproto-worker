# --- Telegram MTProto credentials ---
# Get api_id and api_hash from https://my.telegram.org → API development tools
MTPROTO_API_ID=1234567
MTPROTO_API_HASH=0123456789abcdef0123456789abcdef

# Generate session string ONCE by running: npm run login
MTPROTO_SESSION_STRING=

# --- Lovable Cloud (Supabase) ---
# These come from your Lovable project's .env (Settings → Backend → API)
SUPABASE_URL=https://sorzhrldegdnllziricn.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1...

# --- Worker identity ---
# Which workspace this worker serves
WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Optional: human-readable worker id for logs (default: hostname)
WORKER_ID=railway-prod-1

# Optional: poll interval in seconds (default: 5)
POLL_INTERVAL_SECONDS=5

# Optional: heartbeat interval in seconds (default: 30)
HEARTBEAT_INTERVAL_SECONDS=30
